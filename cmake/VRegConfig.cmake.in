@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/VRegTargets.cmake")

# VReg::Detours needs Detours itself, found the way the build found it.
if("Detours" IN_LIST VReg_FIND_COMPONENTS AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/VRegDetoursTargets.cmake")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Detours)
    list(POP_FRONT CMAKE_MODULE_PATH)
    include("${CMAKE_CURRENT_LIST_DIR}/VRegDetoursTargets.cmake")
endif()

foreach(component IN LISTS VReg_FIND_COMPONENTS)
    if(TARGET VReg::${component})
        set(VReg_${component}_FOUND TRUE)
    else()
        set(VReg_${component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(VReg)
